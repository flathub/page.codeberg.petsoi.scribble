{
    "id": "page.codeberg.petsoi.scribble",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "scribble",
    "finish-args": [
        "--socket=fallback-x11",
        "--env=GSK_RENDERER=gl",
        "--socket=wayland",
        "--device=dri",
        "--share=ipc",
        "--filesystem=~/Scribble Documents:create",
        "--filesystem=xdg-pictures"
    ],
    "modules": [
        {
            "name": "scribble",
            "buildsystem": "meson",
            "build-options": {
                "append-path": "/usr/lib/sdk/rust-stable/bin"
            },
            "sources": [
                {
                    "type": "archive",
                    "url": "https://codeberg.org/petsoi/scribble/archive/v1.11.0.tar.gz",
                    "sha256": "0ae55196b725eaef3af0965edb3bedfe5aa54703c42281dc9e42b8d425a1de9e"
                },
                "cargo-sources.json",
                {
                    "type": "shell",
                    "commands": [
                        "mkdir -p .cargo",
                        "cp cargo/config.toml .cargo/config.toml"
                    ]
                }
            ]
        }
    ]
}
