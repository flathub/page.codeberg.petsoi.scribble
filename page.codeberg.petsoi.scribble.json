{
    "id": "page.codeberg.petsoi.scribble",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm22"
    ],
    "command": "scribble",
    "finish-args": [
        "--socket=fallback-x11",
        "--env=GSK_RENDERER=gl",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--share=ipc",
        "--filesystem=~/Scribble Documents:create",
        "--filesystem=xdg-pictures:ro"
    ],
    "modules": [
        {
            "name": "scribble",
            "buildsystem": "meson",
            "build-options": {
                "append-ld-library-path": "/usr/lib/sdk/llvm22/lib",
                "append-path": "/usr/lib/sdk/rust-stable/bin"
            },
            "sources": [
                {
                    "type": "archive",
                    "url": "https://codeberg.org/petsoi/scribble/archive/v1.12.1.tar.gz",
                    "sha256": "e1e939923e7aaf15e3aa27de3625279a6d71f6e2835e21fceef3c8a587ab47e1"
                },
                "cargo-sources.json",
                {
                    "type": "shell",
                    "commands": [
                        "mkdir -p .cargo",
                        "cp cargo/config.toml .cargo/config.toml"
                    ]
                }
            ]
        }
    ]
}
